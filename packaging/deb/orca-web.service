[Unit]
Description=orca-web hub (orca-server)
Documentation=https://github.com/dchen8525-dev/D-work-orca-web-cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/orca-web/dist-server/orca-server --config /etc/orca-web/server.json
User=orca-web
Group=orca-web
StateDirectory=orca-web
# The hub binds 127.0.0.1:8788 behind a reverse proxy (docs/NAMING.md), so it
# never needs privileged ports. Until P3 the binary is the P0 skeleton: it
# validates its config, logs and exits 0, which systemd reports as inactive.
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-web

[Install]
WantedBy=multi-user.target
